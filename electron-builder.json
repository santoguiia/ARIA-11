{
  "appId": "br.ufsc.ine5448.aria",
  "productName": "ARIA Desktop - Quality Gate de Óbito",
  "copyright": "Copyright © 2024-2026 INE5448 / REF-11",
  "directories": {
    "output": "release"
  },
  "files": [
    "dist/**/*",
    "electron/**/*",
    "package.json"
  ],
  "extraResources": [
    {
      "from": "resources/models",
      "to": "models",
      "filter": ["Qwen2.5-1.5B-Instruct-Q4_K_M.gguf", "*.gguf", "*.json"]
    }
  ],
  "asar": true,
  "asarUnpack": [
    "**/node_modules/node-llama-cpp/**/*"
  ],
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      },
      {
        "target": "portable",
        "arch": ["x64"]
      }
    ],
    "requestedExecutionLevel": "asInvoker"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "ARIA Quality Gate"
  }
}
